# Modelo das variáveis de ambiente. Copie para .env e preencha localmente; o .env não é versionado.
# Variáveis VITE_* vão para o código do navegador: use apenas valores públicos aqui.
# No CI, os mesmos nomes vêm das variáveis do repositório (Settings > Secrets and variables > Actions > Variables).
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_PROJECT_ID=
VITE_LOVABLE_CONNECTOR_GOOGLE_MAPS_BROWSER_KEY=
VITE_LOVABLE_CONNECTOR_GOOGLE_MAPS_TRACKING_ID=
